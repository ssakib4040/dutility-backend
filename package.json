{
  "name": "dutility-backend",
  "version": "1.0.0",
  "description": "Azure Functions API for Dutility.",
  "private": true,
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "storage": "azurite --silent --location .azurite --debug .azurite/debug.log",
    "dev": "npm run clean && npm run build && cross-env FORCE_COLOR=1 concurrently --kill-others-on-fail --prefix-colors \"cyan,magenta\" \"npm run watch\" \"npm run functions\"",
    "start": "func start",
    "functions": "func start",
    "start:verbose": "func start --verbose",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/status.test.js",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "@azure/functions": "^4.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.x",
    "azurite": "^3.37.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
